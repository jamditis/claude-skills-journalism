.superpowers
.superpowers/

# autocontext plugin runtime cache (pending-lessons.json, created when autocontext runs here)
.autocontext
.autocontext/

# Local-only pre-PR linter tooling (not distributed via this repo)
pre-pr-linter
pre-pr-linter/

# Local cross-model review snapshots
.cross-model-review-*/

# Python
__pycache__/
*.py[cod]
.env
venv/

# Node
node_modules/

# Transient axe scan output (regenerated by scripts/verify_a11y.mjs)
scripts/scan-results.json

# Logs
*.log

